{"components":{"schemas":{"Skill":{"properties":{"category":{"example":"trading","type":"string"},"description":{"type":"string"},"featured":{"description":"Present and true only for featured entries","type":"boolean"},"install":{"description":"Shell command that downloads the SKILL.md","type":"string"},"last_verified":{"example":"2026-09-29","format":"date","type":"string"},"name":{"example":"kalshi","type":"string"},"skill_md_url":{"example":"https://raw.githubusercontent.com/oidsdev/honeypot/main/skills/kalshi/SKILL.md","format":"uri","type":"string"},"tags":{"example":["prediction-markets","trading"],"items":{"type":"string"},"type":"array"}},"required":["name","description","category","tags","last_verified","skill_md_url","install"],"type":"object"}}},"info":{"description":"A free, open index of skills for AI agents. Machine-readable. No sign-up, no tracking. Static files only — no auth, no rate limits.","title":"Honeypot","version":"1.0.0"},"openapi":"3.0.0","paths":{"/api/by-category/{category}.json":{"get":{"description":"Same schema envelope as the full index, filtered to one category. Cheaper to poll than the full file. Current categories: trading, data, identity, meta.","parameters":[{"in":"path","name":"category","required":true,"schema":{"example":"trading","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"category":{"example":"trading","type":"string"},"schema_version":{"example":"1","type":"string"},"skills":{"items":{"$ref":"#/components/schemas/Skill"},"type":"array"},"updated":{"format":"date","type":"string"}},"required":["schema_version","category","skills"],"type":"object"}}},"description":"The category index"},"404":{"description":"Unknown category"}},"summary":"Per-category index"}},"/api/changelog.json":{"get":{"description":"Append-only record of skills added to the index: date, name, action, description, skill_md_url.","responses":{"200":{"content":{"application/json":{"schema":{"properties":{"en